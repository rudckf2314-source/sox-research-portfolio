{
  "policy": "CURRENT_REVISED_HISTORY_NEAR_RELEASE_ASSUMPTION_V1",
  "rules": {
    "22": {
      "rule": "M+2 month day10 08:00ET",
      "meaning": "다다음달10일08ET 사용경계 가정;원시월별WSTS의최초공개입증아님;SIA3MA날짜와동일시안함",
      "old": "M+2 month day15",
      "zone": "America/New_York",
      "max_age_days": 120
    },
    "24": {
      "rule": "M+1 month day15 +2 local weekdays, date end Korea",
      "meaning": "통상익월15일마감공표에주말기준2업무일여유;한국공휴일전체달력검증아님.확인된실제공표일우선",
      "old": "M+1 month day20",
      "zone": "Asia/Seoul",
      "max_age_days": 120
    },
    "25": {
      "rule": "official calendar date end Taipei; fallback M+1 day10 +2 local weekdays",
      "meaning": "공식달력월별공표일확인구간은발표일종료후첫미국09시.그외통상10일+2평일가정",
      "old": "M+1 month day20",
      "zone": "Asia/Taipei",
      "max_age_days": 120
    },
    "32": {
      "rule": "verified16:00Taipei +30min; fallback M+1 day23 +2 local weekdays, date end Taipei",
      "meaning": "시각있는공식월보는30분처리여유.나머지통상익월23일+2평일가정.확인된늦은실제발표일이우선",
      "old": "M+2 month day5",
      "zone": "Asia/Taipei",
      "max_age_days": 120
    },
    "36": {
      "rule": "Thursday on/after rawDate, after Thursday date end ET",
      "meaning": "목요일공개설명에따라다음미국거래일09시.원Date가수요일이면그다음목요일,목요일이면당일;나머지는다음목요일가정",
      "old": "after confirmed Thursday publication, next US session",
      "zone": "America/New_York",
      "max_age_days": 21
    },
    "37": {
      "rule": "official formal schedule date end Taipei; fallback M+2 day15 +2 local weekdays",
      "meaning": "정식값은전전월분을공표.2026공식일정우선;그외다다음달15일+2평일가정.이전M+2 day1기준은너무일러폐기",
      "old": "M+2 month day1 (REJECTED_TOO_EARLY)",
      "zone": "Asia/Taipei",
      "max_age_days": 120
    }
  },
